# npm start opens the live desk. Use --recorded for offline replay.
# A provider with historical logs, transactions and eth_call is recommended.
SWAVE_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional accelerated history. Use your own Envio API token.
# A token selects HyperSync automatically; RPC still verifies chain boundaries.
ENVIO_API_TOKEN=
ENVIO_HYPERSYNC_URL=https://robinhood.hypersync.xyz
# Override automatic transport selection if needed:
# SWAVE_TRANSPORT=rpc
