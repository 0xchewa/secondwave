{
  "name": "secondwave-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "A local research terminal for Early Signal and Second Wave on Robinhood Chain",
  "type": "module",
  "engines": { "node": ">=22.12.0 <25" },
  "scripts": {
    "start": "tsx src/cli.ts",
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "bench": "tsx src/cli.ts bench",
    "models": "tsx src/cli.ts models"
  },
  "dependencies": { "tsx": "4.23.13", "viem": "2.56.5" },
  "devDependencies": { "@types/node": "22.20.2", "typescript": "6.0.3" }
}
